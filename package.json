    "@prisma/client": "^7.10.1",
    "@react-three/fiber": "^9.8.2",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "lucide-react": "^1.57.0",
    "motion": "^14.9.1",
    "next": "^16.4.1",
    "nodemailer": "^10.2.1",
    "ogl": "^1.0.11",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
