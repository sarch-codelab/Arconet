#!/usr/bin/env bash
# Al despertar el orb, comprueba que PostgreSQL esté arriba (systemd suele
# arrancarlo solo; esto repara el caso en que no lo hizo).
set -euo pipefail

if ! pg_isready -q -h localhost; then
  sudo systemctl start postgresql@15-main
  for _ in $(seq 1 8); do
    pg_isready -q -h localhost && break
    sleep 1
  done
fi
pg_isready -h localhost
