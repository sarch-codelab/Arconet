# Variables de entorno — Arconet
# Copiar a `.env` y completar. NUNCA versionar el archivo .env real.

# --- Base de datos (PostgreSQL) ---
# Cadena de conexión del servidor Postgres (incluye schema para Prisma).
DATABASE_URL="postgresql://usuario:password@host:5432/arconet?schema=public"

# Ajustes opcionales del pool de conexiones (@prisma/adapter-pg)
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

# --- Sesiones y seguridad ---
# Secreto para firmar cookies de sesión. DEBE ser único por instalación y
# tener 64 caracteres hexadecimales. Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca usar este valor de ejemplo: si .env conserva el placeholder, la app
# se niega a arrancar con NODE_ENV=production (y avisa en desarrollo).
SESSION_SECRET="CAMBIAR-ESTO-genera-con-node-crypto-randomBytes-32-hex"

# --- Datos semilla (solo `npm run db:seed`) ---
# Contraseña inicial de los usuarios de admin que crea prisma/seed.ts
# (admin@arconet.com y sofia.aguilar@arconet.com). Mínimo 12 caracteres.
# Solo se lee al sembrar; después se cambia desde el panel. Cámbiala antes de
# sembrar una base real — el seed aborta sin tocar la base si falta.
SEED_ADMIN_PASSWORD="CAMBIAR-ESTO-contrasena-de-admin-min-12"

# --- Sitio público ---
# Origen canónico del sitio (sin barra final). Se usa en metadataBase,
# sitemap, robots y enlaces dentro de correos.
APP_ORIGIN="https://arconethn.com"

# Correo visible en el catálogo/contacto para clientes.
NEXT_PUBLIC_CONTACT_EMAIL="contacto@arconethn.com"

# --- Correo transaccional (SMTP vía nodemailer) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="no-reply@arconethn.com"
SMTP_PASS="password-smtp"
EMAIL_FROM="Arconet <no-reply@arconethn.com>"

# --- Operaciones (solo scripts de backup) ---
# Directorio donde ops/backup-db.mjs escribe los respaldos.
ARCONET_BACKUP_DIR="C:\\arconet\\backups"
