generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sucursal {
  id           String       @id
  nombre       String
  codigo       String       @unique
  ciudad       String
  direccion    String?
  telefono     String?
  email        String?
  responsable  String?
  estado       String       @default("activo")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  trabajadores Trabajador[]
  usuarios     Usuario[]
}

model Trabajador {
  id         String    @id
  nombre     String
  puesto     String?
  correo     String    @unique
  telefono   String?
  sucursalId String?
  rol        String
  estado     String    @default("activo")
  ingreso    DateTime?
  foto       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id])

  @@index([sucursalId])
  @@index([rol])
  @@index([estado])
  @@index([nombre])
}

model Usuario {
  id           String    @id
  nombre       String
  correo       String    @unique
  passwordHash String
  rol          String    @default("administrador")
  sucursalId   String?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sucursal     Sucursal? @relation(fields: [sucursalId], references: [id])

  @@index([sucursalId])
  @@index([rol])
}

model Producto {
  id          String      @id
  nombre      String
  sku         String      @unique
  categoria   String
  marca       String?
  unidad      String      @default("Unidad")
  descripcion String? // Descripción comercial larga
  precio      Decimal     @db.Decimal(12, 2)
  costo       Decimal?    @db.Decimal(12, 2) // Costo de adquisición (uso interno)
  stock       Int         @default(0)
  stockMinimo Int         @default(0) // Punto de reorden para alertas de inventario
  ubicacion   String? // Ubicación física en bodega
  peso        Decimal?    @db.Decimal(10, 3) // Peso en kilogramos (logística)
  estado      String      @default("activo")
  foto        String? // Imagen principal/portada
  fotos       String[]    @default([]) // Galería de imágenes adicionales
  createdBy   String? // Correo del usuario que creó el registro
  updatedBy   String? // Correo del último usuario que lo modificó
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrdenItem[]

  @@index([categoria])
  @@index([estado])
  @@index([marca])
  @@index([precio])
  @@index([stock])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([nombre])
}

model Categoria {
  id          String   @id
  nombre      String   @unique
  slug        String   @unique
  descripcion String?
  foto        String?
  orden       Int      @default(0)
  estado      String   @default("activo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orden])
  @@index([estado])
}

model Rol {
  id          String   @id
  nombre      String   @unique
  slug        String   @unique
  descripcion String?
  permisos    String[] @default([])
  estado      String   @default("activo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([estado])
}

model Cliente {
  id            String   @id
  nombre        String
  rtn           String?
  contacto      String?
  correo        String?
  telefono      String?
  direccion     String?
  ciudad        String?
  estado        String   @default("activo")
  fechaRegistro DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  foto          String?
  ordenes       Orden[]
  cuenta        ClienteCuenta?

  @@index([estado])
  @@index([fechaRegistro])
  @@index([nombre])
  @@index([rtn])
  @@index([ciudad])
}

model ClienteCuenta {
  id           String   @id
  clienteId    String   @unique
  correo       String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([activo])
}

model Orden {
  id        String      @id
  tipo      String
  clienteId String
  fecha     DateTime    @default(now())
  monto     Decimal     @db.Decimal(12, 2)
  estado    String      @default("pendiente")
  notas     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cliente   Cliente     @relation(fields: [clienteId], references: [id])
  items     OrdenItem[]

  @@index([clienteId])
  @@index([tipo])
  @@index([estado])
  @@index([fecha])
}

model OrdenItem {
  id         String    @id @default(cuid())
  ordenId    String
  productoId String?
  nombre     String
  cantidad   Decimal   @db.Decimal(12, 3)
  precio     Decimal   @db.Decimal(12, 2)
  orden      Orden     @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  producto   Producto? @relation(fields: [productoId], references: [id])

  @@index([ordenId])
  @@index([productoId])
}

model Log {
  id        String   @id @default(cuid())
  nivel     String   @default("info")
  categoria String
  mensaje   String
  detalle   String?
  actor     String?
  ruta      String?
  createdAt DateTime @default(now())

  @@index([categoria])
  @@index([nivel])
  @@index([createdAt])
}
