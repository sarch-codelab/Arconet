generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sucursal {
  id           String       @id
  nombre       String
  codigo       String       @unique
  ciudad       String
  direccion    String?
  telefono     String?
  email        String?
  responsable  String?
  estado       String       @default("activo")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  trabajadores Trabajador[]
  usuarios     Usuario[]
  bodegas      Bodega[]
}

model Trabajador {
  id         String    @id
  nombre     String
  puesto     String?
  correo     String    @unique
  telefono   String?
  sucursalId String?
  rol        String
  estado     String    @default("activo")
  ingreso    DateTime?
  foto       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id])

  @@index([sucursalId])
  @@index([rol])
  @@index([estado])
  @@index([nombre])
}

model Usuario {
  id           String    @id
  nombre       String
  correo       String    @unique
  passwordHash String
  telefono     String?
  foto         String?
  rol          String    @default("administrador")
  sucursalId   String?
  activo       Boolean   @default(true)
  verificadoAt DateTime? // Verificación de correo
  consentimientoAt DateTime? // Aceptación de términos y privacidad
  ultimoAccesoAt    DateTime?
  intentosFallidos  Int      @default(0)
  bloqueadoHasta    DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  temaPanel    String    @default("system")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sucursal     Sucursal? @relation(fields: [sucursalId], references: [id])
  sesiones     SesionUsuario[]

  @@index([sucursalId])
  @@index([rol])
}

model SesionUsuario {
  id          String    @id
  sessionId   String    @unique
  usuarioId   String
  userAgent   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revokedAt, expiresAt])
}

model ConfiguracionSistema {
  clave     String   @id
  valor     String
  updatedAt DateTime @updatedAt
}

model Producto {
  id          String      @id
  nombre      String
  sku         String      @unique
  codigoBarras String? // Código de barras del fabricante (EAN/UPC), opcional
  categoria   String
  marca       String?
  unidad      String      @default("Unidad")
  descripcion String? // Descripción comercial larga
  precio      Decimal     @db.Decimal(12, 2)
  precioDescuento Decimal? @db.Decimal(12, 2)
  precioMayorista Decimal? @db.Decimal(12, 2)
  preciosUpdatedAt DateTime?
  preciosUpdatedBy String?
  costo       Decimal?    @db.Decimal(12, 2) // Costo de adquisición (uso interno)
  stock       Int         @default(0)
  stockMinimo Int         @default(0) // Punto de reorden para alertas de inventario
  ubicacion   String? // Ubicación física en bodega
  peso        Decimal?    @db.Decimal(10, 3) // Peso en kilogramos (logística)
  estado      String      @default("activo")
  archivado   Boolean     @default(false) // Baja definitiva conservando el historial
  archivadoAt DateTime?
  foto        String? // Imagen principal/portada
  fotos       String[]    @default([]) // Galería de imágenes adicionales
  createdBy   String? // Correo del usuario que creó el registro
  updatedBy   String? // Correo del último usuario que lo modificó
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrdenItem[]
  stockPorBodega ProductoStock[]
  movimientos MovimientoKardex[]
  ordenCompraItems OrdenCompraItem[]
  documentoItems DocumentoFiscalItem[]

  @@index([categoria])
  @@index([estado])
  @@index([marca])
  @@index([precio])
  @@index([stock])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([nombre])
  @@index([codigoBarras])
  @@index([archivado])
}

model Categoria {
  id          String   @id
  nombre      String   @unique
  slug        String   @unique
  descripcion String?
  foto        String?
  orden       Int      @default(0)
  estado      String   @default("activo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orden])
  @@index([estado])
}

model Rol {
  id          String   @id
  nombre      String   @unique
  slug        String   @unique
  descripcion String?
  permisos    String[] @default([])
  estado      String   @default("activo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([estado])
}

model Cliente {
  id            String   @id
  nombre        String
  rtn           String?
  contacto      String?
  correo        String?
  telefono      String?
  direccion     String?
  ciudad        String?
  estado        String   @default("activo")
  segmento      String? // Segmentación comercial (ej. mayorista, integrador, gobierno)
  etiquetas     String[] @default([])
  fechaRegistro DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  foto          String?
  ordenes       Orden[]
  cuenta        ClienteCuenta?
  documentos    DocumentoFiscal[]

  @@index([estado])
  @@index([fechaRegistro])
  @@index([nombre])
  @@index([rtn])
  @@index([ciudad])
}

model ClienteCuenta {
  id           String   @id
  clienteId    String   @unique
  correo       String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  estado       String   @default("pendiente") // pendiente | aprobado | rechazado (aprobación de cuentas)
  aprobadoPor  String?
  aprobadoAt   DateTime?
  verificadoAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([activo])
  @@index([estado])
}

model Orden {
  id               String      @id
  tipo             String
  clienteId        String
  fecha            DateTime    @default(now())
  monto            Decimal     @db.Decimal(12, 2)
  estado           String      @default("pendiente")
  notas            String?
  fechaVencimiento DateTime? // Vencimiento de la cotización/venta
  descuento        Decimal     @default(0) @db.Decimal(12, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cliente          Cliente     @relation(fields: [clienteId], references: [id])
  items            OrdenItem[]
  pagos            Pago[]
  eventos          OrdenEvento[]
  entregas         Entrega[]
  devoluciones     Devolucion[]
  documentos       DocumentoFiscal[]

  @@index([clienteId])
  @@index([tipo])
  @@index([estado])
  @@index([fecha])
  @@index([fechaVencimiento])
}

model OrdenItem {
  id         String    @id @default(cuid())
  ordenId    String
  productoId String?
  nombre     String
  cantidad   Decimal   @db.Decimal(12, 3)
  precio     Decimal   @db.Decimal(12, 2)
  nivelPrecio String?
  precioBase Decimal? @db.Decimal(12, 2)
  orden      Orden     @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  producto   Producto? @relation(fields: [productoId], references: [id])

  @@index([ordenId])
  @@index([productoId])
}

model Log {
  id        String   @id @default(cuid())
  nivel     String   @default("info")
  categoria String
  mensaje   String
  detalle   String?
  actor     String?
  ruta      String?
  createdAt DateTime @default(now())

  @@index([categoria])
  @@index([nivel])
  @@index([createdAt])
}

model SolicitudInterna {
  id                 String                 @id
  titulo             String
  descripcion        String
  area               String
  prioridad          String                 @default("normal")
  estado             String                 @default("pendiente")
  solicitanteCorreo  String
  solicitanteNombre  String
  solicitanteRol     String
  responsableCorreo  String?
  fechaLimite        DateTime? // SLA según prioridad
  cerradaAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  comentarios        ComentarioSolicitud[]
  notificaciones     Notificacion[]
  adjuntos           SolicitudAdjunto[]
  eventos            SolicitudEvento[]

  @@index([area, estado, createdAt])
  @@index([solicitanteCorreo, createdAt])
  @@index([responsableCorreo])
  @@index([fechaLimite])
}

model AreaSolicitud {
  id        String   @id
  nombre    String
  slug      String   @unique
  roles     String[]
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activa, nombre])
}

model ComentarioSolicitud {
  id                String           @id @default(cuid())
  solicitudId       String
  autorCorreo       String
  autorNombre       String
  autorRol          String
  mensaje           String
  createdAt         DateTime         @default(now())
  solicitud         SolicitudInterna @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([solicitudId, createdAt])
}

model Notificacion {
  id            String            @id @default(cuid())
  recipient     String
  title         String
  message       String
  type          String            @default("solicitud")
  solicitudId   String?
  readAt        DateTime?
  createdAt     DateTime          @default(now())
  solicitud     SolicitudInterna? @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([recipient, readAt, createdAt])
  @@index([solicitudId])
}

// ─────────────────────────────────────────────────────────────────────
// Fase A · Inventario y compras
// ─────────────────────────────────────────────────────────────────────

model Bodega {
  id          String   @id @default(cuid())
  nombre      String
  codigo      String   @unique
  sucursalId  String?
  direccion   String?
  esPrincipal Boolean  @default(false)
  estado      String   @default("activo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sucursal    Sucursal? @relation(fields: [sucursalId], references: [id])
  stock       ProductoStock[]
  movimientos MovimientoKardex[]
  recepciones RecepcionCompra[]

  @@index([estado])
  @@index([sucursalId])
}

model ProductoStock {
  id         String   @id @default(cuid())
  productoId String
  bodegaId   String
  cantidad   Int      @default(0)
  updatedAt  DateTime @updatedAt
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  bodega     Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Cascade)

  @@unique([productoId, bodegaId])
  @@index([bodegaId])
}

model MovimientoKardex {
  id              String    @id @default(cuid())
  fecha           DateTime  @default(now())
  tipo            String // entrada | salida | ajuste | transferencia | devolucion
  productoId      String
  bodegaId        String
  bodegaDestinoId String? // Solo para transferencias entre bodegas
  cantidad        Int
  saldoAnterior   Int
  saldoDespues    Int
  costoUnitario   Decimal?  @db.Decimal(12, 2)
  referencia      String? // oc:<id>, orden:<id>, manual, devolucion:<id>
  motivo          String?
  actor           String?
  ordenCompraId   String?
  ordenId         String?
  createdAt       DateTime  @default(now())
  producto        Producto  @relation(fields: [productoId], references: [id])
  bodega          Bodega    @relation(fields: [bodegaId], references: [id])

  @@index([productoId, fecha])
  @@index([bodegaId, fecha])
  @@index([tipo, fecha])
  @@index([ordenCompraId])
}

model Proveedor {
  id        String        @id @default(cuid())
  nombre    String
  rtn       String?
  contacto  String?
  telefono  String?
  email     String?
  direccion String?
  notas     String?
  estado    String        @default("activo")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  ordenes   OrdenCompra[]

  @@index([estado])
  @@index([nombre])
}

model OrdenCompra {
  id             String            @id @default(cuid())
  numero         String            @unique // OC-2026-0001
  proveedorId    String
  tipo           String            @default("compra") // compra | cotizacion (a proveedor)
  requeridoA     String?
  terminos       String            @default("contado") // contado | credito; no implica pago
  diasCredito    Int               @default(0)
  fechaVencimiento DateTime?
  facturaProveedor String?
  envio          String?
  moneda         String            @default("HNL")
  impuesto       Decimal           @default(0) @db.Decimal(12, 2)
  cotizacionOrigenId String?        @unique
  cotizacionOrigen OrdenCompra?    @relation("CompraDesdeCotizacion", fields: [cotizacionOrigenId], references: [id], onDelete: Restrict)
  compraGenerada OrdenCompra?      @relation("CompraDesdeCotizacion")
  recepciones    RecepcionCompra[]
  estado         String            @default("borrador") // borrador | enviada | parcial | recibida | cancelada
  fecha          DateTime          @default(now())
  fechaEsperada  DateTime?
  fechaRecepcion DateTime?
  subtotal       Decimal           @default(0) @db.Decimal(12, 2)
  total          Decimal           @default(0) @db.Decimal(12, 2)
  notas          String?
  createdBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  proveedor      Proveedor         @relation(fields: [proveedorId], references: [id])
  items          OrdenCompraItem[]

  @@index([proveedorId])
  @@index([estado])
  @@index([fecha])
}

model OrdenCompraItem {
  id                String       @id @default(cuid())
  ordenCompraId     String
  productoId        String?
  nombre            String
  cantidad          Int
  cantidadRecibida  Int          @default(0)
  costoUnitario     Decimal      @db.Decimal(12, 2)
  impuestoPorcentaje Decimal    @default(0) @db.Decimal(5, 2)
  ordenCompra       OrdenCompra  @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  producto          Producto?    @relation(fields: [productoId], references: [id])

  @@index([ordenCompraId])
}

// ─────────────────────────────────────────────────────────────────────
// Fase A · Ventas: pagos, historial, entregas y devoluciones
// ─────────────────────────────────────────────────────────────────────

model Pago {
  id            String   @id @default(cuid())
  ordenId       String
  fecha          DateTime @default(now())
  monto          Decimal  @db.Decimal(12, 2)
  metodo         String   @default("efectivo") // efectivo | transferencia | tarjeta | cheque | otro
  referencia     String?
  estado         String   @default("confirmado") // pendiente | confirmado | anulado
  registradoPor  String?
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orden          Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId, estado])
  @@index([fecha])
}

model OrdenEvento {
  id        String   @id @default(cuid())
  ordenId   String
  fecha     DateTime @default(now())
  tipo      String   // estado | pago | entrega | devolucion | edicion | nota
  deEstado  String?
  aEstado   String?
  mensaje   String?
  actor     String?
  orden     Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId, fecha])
}

model Entrega {
  id              String   @id @default(cuid())
  ordenId         String
  tipo            String   @default("entrega") // despacho | entrega
  estado          String   @default("programada") // programada | en_camino | entregada | fallida
  fechaProgramada DateTime?
  fechaReal       DateTime?
  transportista   String?
  guia            String?
  notas           String?
  registradoPor   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orden           Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId, estado])
}

model Devolucion {
  id            String            @id @default(cuid())
  ordenId       String
  fecha         DateTime          @default(now())
  estado        String            @default("pendiente") // pendiente | aceptada | rechazada | reembolsada
  motivo        String
  monto         Decimal           @default(0) @db.Decimal(12, 2)
  registradoPor String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  orden         Orden             @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  items         DevolucionItem[]

  @@index([ordenId, estado])
}

model DevolucionItem {
  id           String      @id @default(cuid())
  devolucionId String
  ordenItemId  String?
  nombre       String
  cantidad     Int
  precio       Decimal     @db.Decimal(12, 2)
  devolucion   Devolucion  @relation(fields: [devolucionId], references: [id], onDelete: Cascade)

  @@index([devolucionId])
}

// ─────────────────────────────────────────────────────────────────────
// Fase B · Facturación (estructura lista para CAI cuando se reciban los
// rangos autorizados: serie, correlativo y CAI quedan opcionales por ahora)
// ─────────────────────────────────────────────────────────────────────

model DocumentoFiscal {
  id              String              @id @default(cuid())
  tipo            String // factura | nota_credito | nota_debito
  cai             String? // CAI autorizado (pendiente)
  serie           String? // Rango/serie autorizado (pendiente)
  correlativo     String? // Correlativo fiscal (pendiente)
  fecha           DateTime            @default(now())
  clienteId       String
  ordenId         String?
  estado          String              @default("emitido") // emitido | anulado
  subtotal        Decimal             @db.Decimal(12, 2)
  descuento       Decimal             @default(0) @db.Decimal(12, 2)
  impuesto        Decimal             @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  moneda          String              @default("HNL")
  referenciaId    String? // Documento relacionado (anulación o nota)
  pdfHash         String? // Huella SHA-256 del PDF para garantizar inmutabilidad
  emitidoPor      String?
  motivoAnulacion String?
  anuladoPor      String?
  anuladoAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  cliente         Cliente             @relation(fields: [clienteId], references: [id])
  orden           Orden?              @relation(fields: [ordenId], references: [id])
  items           DocumentoFiscalItem[]

  @@index([tipo, estado])
  @@index([clienteId])
  @@index([fecha])
  @@index([ordenId])
}

model DocumentoFiscalItem {
  id                String         @id @default(cuid())
  documentoId       String
  productoId        String? // Producto del catálogo (null en conceptos libres)
  descripcion       String
  cantidad          Decimal        @db.Decimal(12, 3)
  precio            Decimal        @db.Decimal(12, 2)
  descuento         Decimal        @default(0) @db.Decimal(12, 2)
  impuestoPorcentaje Decimal       @default(15) @db.Decimal(5, 2)
  subtotal          Decimal        @db.Decimal(12, 2)
  nivelPrecio       String?
  precioBase        Decimal? @db.Decimal(12, 2)
  documento         DocumentoFiscal @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  producto          Producto?      @relation(fields: [productoId], references: [id])

  @@index([documentoId])
  @@index([productoId])
}

// ─────────────────────────────────────────────────────────────────────
// Fase C · Operación interna: SLA, historial y adjuntos
// ─────────────────────────────────────────────────────────────────────

model SolicitudAdjunto {
  id           String           @id @default(cuid())
  solicitudId  String
  nombre       String
  tipo         String // mime
  tamano       Int // bytes
  contenido    String // base64 (máx. ~2 MB por archivo)
  autorCorreo  String
  createdAt    DateTime         @default(now())
  solicitud    SolicitudInterna @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([solicitudId])
}

model SolicitudEvento {
  id            String           @id @default(cuid())
  solicitudId   String
  fecha         DateTime         @default(now())
  tipo          String // estado | responsable | prioridad | sla | adjunto | nota
  de            String?
  a             String?
  mensaje       String?
  actorCorreo   String
  actorNombre   String?
  solicitud     SolicitudInterna @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([solicitudId, fecha])
}

// ─────────────────────────────────────────────────────────────────────
// Fase D · Recuperación de contraseña y verificación de correo
// ─────────────────────────────────────────────────────────────────────

model TokenAcceso {
  id         String   @id @default(cuid())
  correo     String
  codigoHash String // scrypt del código de un solo uso
  tipo       String // recuperacion | verificacion
  expiraAt   DateTime
  usadoAt    DateTime?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([correo, tipo, usadoAt])
  @@index([expiraAt])
}

// Cada entrega de proveedor es inmutable y lleva una clave de idempotencia.
model RecepcionCompra {
  id            String      @id @default(cuid())
  ordenCompraId String
  requestId     String      @unique
  huella        String
  bodegaId      String
  detalle       Json
  notas         String?
  actor         String?
  createdAt     DateTime    @default(now())
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  bodega        Bodega      @relation(fields: [bodegaId], references: [id])

  @@index([ordenCompraId, createdAt])
}
